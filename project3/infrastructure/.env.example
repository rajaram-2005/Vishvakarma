# SUTRA — environment (copy to .env; .env is gitignored)

# --- privacy ---
SUTRA_PRIVACY_MODE=hybrid        # local | hybrid | cloud
SUTRA_SYNC_SCOPE=none            # none | metadata | projects | folders | workspace

# --- local runtimes (host machine) ---
OLLAMA_URL=http://host.docker.internal:11434

# --- openai-compatible (optional; never required) ---
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- infrastructure credentials (local dev defaults shown) ---
POSTGRES_PASSWORD=sutra-local
GRAFANA_PASSWORD=sutra-local

# --- puter (optional layer; local mode never forces this) ---
PUTER_JWT=
