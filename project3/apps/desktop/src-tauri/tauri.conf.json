{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SUTRA",
  "version": "0.1.0",
  "identifier": "app.sutra.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../../web run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm --prefix ../../web run build",
    "frontendDist": "../../../web/.next"
  },
  "app": {
    "windows": [
      {
        "title": "SUTRA — AI Operating Workspace",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "backgroundColor": "#050510",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
